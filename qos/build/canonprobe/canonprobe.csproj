<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>canonprobe</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The EXACT shipping source of the mod's canonical builder,
         compiled in — executing this executes BuilderJson as built
         from the tree. (The dll mode in Program.cs additionally
         invokes the methods on the packaged net48 DLL itself.) -->
    <Compile Include="..\..\QoSBuilder\BuilderJson.cs" Link="BuilderJson.cs" />
  </ItemGroup>
</Project>
