<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>QoSChickens</AssemblyName>
    <RootNamespace>QoSChickens</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\QoSChickens\*.cs" LinkBase="src" />
    <!-- QoSCore comes from the QoSCore mod folder at runtime via the
         manifest dependency; it must NOT be copied into this mod's
         folder (Private=false / ReferenceOutputAssembly copy off). -->
    <ProjectReference Include="..\core\QoSCore.csproj">
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="Mafi">
      <HintPath>..\..\..\refs\Mafi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Core">
      <HintPath>..\..\..\refs\Mafi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Unity">
      <HintPath>..\..\..\refs\Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
