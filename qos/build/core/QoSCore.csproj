<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CoiRefsDir Condition="'$(CoiRefsDir)'==''">..\..\..efs\</CoiRefsDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>QoSCore</AssemblyName>
    <RootNamespace>QoSCore</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\QoSCore\*.cs" LinkBase="src" />
    <Reference Include="Mafi">
      <HintPath>$(CoiRefsDir)\Mafi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Core">
      <HintPath>$(CoiRefsDir)\Mafi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Unity">
      <HintPath>$(CoiRefsDir)\Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
