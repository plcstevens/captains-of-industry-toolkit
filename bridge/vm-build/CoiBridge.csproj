<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CoiRefsDir Condition="'$(CoiRefsDir)'==''">../../refs/</CoiRefsDir>
  </PropertyGroup>
  <!-- VM-side build for CoiBridge (Claudius builds; Philip does not).
       The VS/template project remains ../CoiBridge/CoiBridge.csproj.
       This project compiles the SAME sources against the game's own
       assemblies, expected in ../../refs/ (from Philip's install:
       Mafi*.dll + Assembly-CSharp.dll). Framework references come from
       the Microsoft.NETFramework.ReferenceAssemblies.net48 package, so
       no Windows / Visual Studio / COI_ROOT is needed.
       AssemblyName must stay "CoiBridge": manifest.json primary_dlls
       names CoiBridge.dll. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CoiBridge</AssemblyName>
    <RootNamespace>CoiBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../CoiBridge/*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Mafi">
      <HintPath>$(CoiRefsDir)/Mafi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Core">
      <HintPath>$(CoiRefsDir)/Mafi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Base">
      <HintPath>$(CoiRefsDir)/Mafi.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Unity">
      <HintPath>$(CoiRefsDir)/Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
